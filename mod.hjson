{
  name: "item-liquid-teleport",
  displayName: "Item Liquid Teleport",
  author: "namds666 & Claude Code & Codex",
  subtitle: "v1.4.18: Yuri auto-targets within its own 30 tile range",
  description: "Cheat-grade Chrono blocks for global item and liquid transport, terrain and item conversion, repair, construction, overdrive, unit buffs and debuffs, mind control, and core placement, plus the Outpost, a base that builds mining drones.\n\n[accent]v1.4.18[]\nYuri now finds targets within its own 30 tile range around itself, so it keeps converting wherever it walks. Upgrades now only shorten the channel time.\n\n[accent]v1.4.17[]\nChrono Hypno is now 1x1. Four in a 2x2 square merge into a Big Chrono Hypno, whose Big Yuri tethers two targets at once. More Yuri on one target convert it faster: two Yuri take half the time.\n\n[accent]v1.4.16[]\nShorter mod description with changes listed by version.\n\n[accent]v1.4.15[]\nOutpost, Quad Outpost, and Mega Outpost: the mine tier 4 upgrade costs titanium and silicon.\n\n[accent]v1.4.14[]\nNew Chrono Hypno: Yuri converts enemy units and buildings to your side.",
  version: "1.4.18",
  minGameVersion: "146"
}
